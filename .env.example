# Copy to .env at the repo root (git-ignored). Every example walks up to this file for its keys.

# --- Opik ---------------------------------------------------------------
# Self-hosted Opik (https://www.comet.com/docs/opik/self-host/local_deployment) needs no API key.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# For Opik Cloud instead: OPIK_URL_OVERRIDE=https://www.comet.com/opik/api/ plus OPIK_API_KEY and your workspace.
# OPIK_API_KEY=

# --- LLM providers ------------------------------------------------------
# Required by almost every example. https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Used by the Anthropic examples. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional, only for examples that pick Gemini. https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Optional, only for examples that pick Mistral. https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
