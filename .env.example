# Copy to .env at the repo root (git-ignored). Every example walks up to this file for its keys,
# and each example's own .env.example lists the subset it reads.

# --- Opik ---------------------------------------------------------------
# Self-hosted Opik (https://www.comet.com/docs/opik/self-host/local_deployment) needs no API key.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# For Opik Cloud instead: OPIK_URL_OVERRIDE=https://www.comet.com/opik/api/ plus OPIK_API_KEY and your workspace.
# https://www.comet.com/account-settings/apiKeys
# OPIK_API_KEY=
# Each example sets its own project (named after its folder); only override it on purpose.
# OPIK_PROJECT_NAME=

# --- LLM providers ------------------------------------------------------
# Required by every example except the Anthropic museum guide and the fully local Ollama one. https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Used by the museum-guide and flashcard-router examples. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Optional, per example ---------------------------------------------
# ollama-homebrew-rag: where your local Ollama listens.
# OLLAMA_BASE_URL=http://localhost:11434
# OTel-based examples derive the OTLP endpoint from OPIK_URL_OVERRIDE; set this only to override it.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5173/api/v1/private/otel
# Local ports for examples that start a server (defaults shown).
# TEMPORAL_PORT=7243
# N8N_PORT=5678
# LANGFLOW_PORT=7860
