# Read from the repo-root .env (or your shell). Only the variables below are used.

# OpenAI key, handed to Langflow as its OPENAI_API_KEY global variable.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opik. Self-hosted on this machine (https://www.comet.com/docs/opik/self-host/local_deployment):
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# For Opik Cloud instead: OPIK_URL_OVERRIDE=https://www.comet.com/opik/api/, your workspace, and
# OPIK_API_KEY (https://www.comet.com/account-settings/apiKeys).
# OPIK_API_KEY=

# Optional: host port for the Langflow UI and API (default 7860).
# LANGFLOW_PORT=7860
