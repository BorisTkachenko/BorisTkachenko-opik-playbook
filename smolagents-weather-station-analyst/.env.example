# OpenAI key: the agent runs on gpt-4o-mini
OPENAI_API_KEY=your-openai-key
# Where Opik's OTLP endpoint lives. Local self-hosted shown; no Authorization header needed locally.
# For Opik Cloud use https://www.comet.com/opik/api/v1/private/otel and add Authorization=<api key> to the headers.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5173/api/v1/private/otel
OPIK_WORKSPACE=default
