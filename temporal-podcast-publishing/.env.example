# Copy to .env (git-ignored) or keep these in the repo-root .env, which the example also reads.

# --- OpenAI: the two drafting activities use gpt-4o-mini ---
OPENAI_API_KEY=

# --- Opik: both the starter and the worker process read these ---
# Self-hosted Opik needs no key. For Opik Cloud, also set OPIK_API_KEY and your workspace.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# OPIK_API_KEY=
OPIK_PROJECT_NAME=temporal-podcast-publishing

# --- Optional ---
# Port for the throwaway Temporal dev server that `npm run demo` starts.
# TEMPORAL_PORT=7243
