{
  "name": "temporal-podcast-publishing",
  "version": "1.0.0",
  "private": true,
  "description": "Durable podcast-episode publishing on Temporal + OpenAI; one Opik trace across the starter and the worker process",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "start": "npm run demo",
    "demo": "tsx src/demo.ts",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "verify": "tsx src/verify.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@temporalio/activity": "^1.13.0",
    "@temporalio/client": "^1.13.0",
    "@temporalio/testing": "^1.13.0",
    "@temporalio/worker": "^1.13.0",
    "@temporalio/workflow": "^1.13.0",
    "dotenv": "^17.0.0",
    "openai": "^6.0.0",
    "opik": "2.3.4",
    "opik-openai": "2.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "opik-openai": {
      "opik": "$opik"
    }
  }
}
