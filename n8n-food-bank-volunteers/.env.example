# Read from the repo-root .env (or your shell). Only the variables below are used.

# OpenAI key for the screening node. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Self-hosted Opik on this machine (https://www.comet.com/docs/opik/self-host/local_deployment):
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# For Opik Cloud instead: OPIK_URL_OVERRIDE=https://www.comet.com/opik/api/ plus your workspace and
# OPIK_API_KEY (https://www.comet.com/account-settings/apiKeys).
# OPIK_API_KEY=

# Optional: host port for the n8n UI and webhook (default 5678).
# N8N_PORT=5678
