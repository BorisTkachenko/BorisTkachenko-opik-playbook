# Nothing here is a secret: this example has no cloud LLM provider at all.
OLLAMA_BASE_URL=http://localhost:11434
# Opik: self-hosted needs no key. For Opik Cloud add OPIK_API_KEY and your workspace.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
OPIK_PROJECT_NAME=ollama-homebrew-rag
