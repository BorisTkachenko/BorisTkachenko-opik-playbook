# Provider key (or put it in a repo-root .env; the app walks up from this folder to find one).
ANTHROPIC_API_KEY=

# Opik: local self-hosted stack (leave OPIK_API_KEY unset). For Opik Cloud use
# OPIK_URL_OVERRIDE=https://www.comet.com/opik/api plus OPIK_API_KEY and OPIK_WORKSPACE.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
