# OpenAI API key used by the agents (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key

# Opik: leave both unset to use ~/.opik.config (run `opik configure`), or set them here.
# Self-hosted example: OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_URL_OVERRIDE=
OPIK_WORKSPACE=
OPIK_API_KEY=
