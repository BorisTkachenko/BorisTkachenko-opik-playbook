# OpenAI key: the vision model reads the label images and the test-suite judge grades them
OPENAI_API_KEY=sk-...
# Opik: only needed if you have not run `opik configure` (which writes ~/.opik.config)
OPIK_API_KEY=
OPIK_WORKSPACE=
# Self-hosted Opik, e.g. http://localhost:5173/api/
OPIK_URL_OVERRIDE=
