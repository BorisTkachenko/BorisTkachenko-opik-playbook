# Only the OpenAI key is required. This file is optional: the app also reads the
# nearest .env found by walking up from this folder.
OPENAI_API_KEY=your-openai-api-key

# Opik: for a local self-hosted stack (adjust to your URL); for Opik Cloud use
# OPIK_API_KEY and OPIK_WORKSPACE instead.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
