# OpenAI key: gpt-4o-mini answers the chat. Opik's judge also uses an OpenAI key,
# registered in Opik itself (Settings > AI Providers), not here.
OPENAI_API_KEY=your-openai-api-key

# Local self-hosted Opik. For Opik Cloud use https://www.comet.com/opik/api plus OPIK_API_KEY.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# OPIK_API_KEY=your-opik-api-key
