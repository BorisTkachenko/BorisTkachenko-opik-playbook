# OpenAI: the agent runs on gpt-4o-mini
OPENAI_API_KEY=sk-...

# Local self-hosted Opik needs no API key. The demo reads these from this file
# or from the repo-root .env (it walks up).
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# Project the traces land in (defaults to mastra-banking-agent)
# OPIK_PROJECT_NAME=mastra-banking-agent

# Opik Cloud instead: OPIK_URL_OVERRIDE=https://www.comet.com/opik/api, OPIK_API_KEY=..., OPIK_WORKSPACE=<your workspace>
# OPIK_API_KEY=
