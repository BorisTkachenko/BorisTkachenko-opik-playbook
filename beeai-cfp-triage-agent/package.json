{
  "name": "beeai-cfp-triage-agent",
  "version": "1.0.0",
  "private": true,
  "description": "A BeeAI ReAct agent that triages conference talk proposals, traced to Opik with OpenInference over OTLP.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "demo": "tsx src/cli.ts demo",
    "triage": "tsx src/cli.ts triage",
    "verify": "tsx src/cli.ts verify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.13",
    "@arizeai/openinference-instrumentation-beeai": "^1.6.8",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.57.2",
    "@opentelemetry/sdk-node": "^0.57.2",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "beeai-framework": "0.1.13",
    "dotenv": "^17.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
